# Local: docker compose up -d (voir docker-compose.yml). Production: URL fournie
# par la base PostgreSQL managee du fournisseur cloud.
DATABASE_URL="postgresql://pndfe:pndfe_dev_local@localhost:5432/pndfe"
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=4300
UPLOADS_DIR="uploads"
# Utilise pour construire l'URL de verification encodee dans le QR Code
PUBLIC_APP_URL="http://localhost:5190"
# Origine autorisee pour les requetes CORS (URL du frontend). En production,
# utiliser l'URL publique reelle (ex: https://pndfe.gouv.ci).
FRONTEND_URL="http://localhost:5190"
