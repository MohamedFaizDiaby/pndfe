// PNDFE - Etape 1 : Identite numerique des travailleurs et des agences
// PNDFE - Etape 2 : Contrats de travail electroniques + declarations CNPS/CMU
// PNDFE - Etape 3 : Paiement des salaires (Mobile Money simule) + bulletins de paie
// PNDFE - Mise en relation : offres d'emploi publiees par les agences, candidatures des travailleurs
// PNDFE - Etape 4 : journal d'audit (tracabilite des actions sensibles)
// PostgreSQL en developpement (via docker-compose, voir backend/docker-compose.yml)
// et en production (base managee du fournisseur cloud). Le schema a d'abord
// ete developpe sous SQLite (aucun serveur a installer) puis migre ici pour
// le passage au cloud - voir DEPLOIEMENT.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Les statuts restent des String (et non des enums Postgres natifs) pour ne
// pas re-ecrire les migrations existantes ni le code applicatif qui les
// manipule deja via src/common/enums.ts (TS enums) - un changement purement
// cosmetique, sans benefice fonctionnel, qui aurait ajoute du risque inutile
// a cette migration.
// Role: TRAVAILLEUR | AGENCE | ADMIN
// StatutAgrement: EN_ATTENTE | APPROUVE | REJETE
// StatutVerificationIdentite: EN_ATTENTE | VERIFIE | REJETE
// StatutContrat: ENVOYE | SIGNE | REFUSE
// MethodePaiement: ORANGE_MONEY | MTN_MOMO
// StatutPaiement: REUSSI | ECHEC
// StatutOffre: OUVERTE | FERMEE
// StatutCandidature: EN_ATTENTE | ACCEPTEE | REJETEE

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())

  travailleur Travailleur?
  agence      Agence?
}

model Travailleur {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nom                  String
  prenoms              String
  dateNaissance        DateTime
  telephone            String
  metier               String // ex: BTP, gardiennage, domestique, restauration...
  numeroPieceIdentite  String
  photoUrl             String?
  pieceIdentiteUrl     String?

  qrCodeToken          String @unique @default(uuid())
  statutVerification   String @default("EN_ATTENTE")

  contrats     Contrat[]
  candidatures Candidature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agence {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  raisonSociale    String
  registreCommerce String
  telephone        String
  adresse          String
  // Secteurs d'activite stockes en CSV ("BTP,GARDIENNAGE") - liste geree cote service.
  secteurs         String

  documents       Document[]
  demandeAgrement DemandeAgrement?
  contrats        Contrat[]
  offres          OffreEmploi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id        String   @id @default(uuid())
  agenceId  String
  agence    Agence   @relation(fields: [agenceId], references: [id], onDelete: Cascade)
  type      String // ex: RCCM, ATTESTATION_FISCALE, PIECE_DIRIGEANT
  nomFichier String
  url       String
  createdAt DateTime @default(now())
}

model DemandeAgrement {
  id                 String    @id @default(uuid())
  agenceId           String    @unique
  agence             Agence    @relation(fields: [agenceId], references: [id], onDelete: Cascade)
  statut             String    @default("EN_ATTENTE")
  commentaireAdmin   String?
  traiteParUserId    String?
  dateTraitement     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Contrat {
  id String @id @default(uuid())

  agenceId      String
  agence        Agence      @relation(fields: [agenceId], references: [id], onDelete: Cascade)
  travailleurId String
  travailleur   Travailleur @relation(fields: [travailleurId], references: [id], onDelete: Cascade)

  typeContrat String // BTP, GARDIENNAGE, DOMESTIQUE, RESTAURATION, AGRICULTURE, MANUTENTION, AUTRE
  poste       String
  lieuTravail String
  salaireBrut Float
  dateDebut   DateTime
  dateFin     DateTime?

  statut String @default("ENVOYE")

  signatureTravailleurNom String? // nom saisi par le travailleur en guise de signature electronique
  signatureTravailleurAt  DateTime?
  motifRefus              String?
  pdfUrl                  String?

  declaration DeclarationCnps?
  paiements   Paiement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Paiement {
  id String @id @default(uuid())

  contratId String
  contrat   Contrat @relation(fields: [contratId], references: [id], onDelete: Cascade)

  periode String // "AAAA-MM", ex: "2026-08"

  salaireBrut    Float
  cotisationCnps Float
  cotisationCmu  Float
  salaireNet     Float

  methodePaiement       String // ORANGE_MONEY | MTN_MOMO
  telephoneBeneficiaire String
  statut                String @default("REUSSI")
  referenceTransaction  String @unique

  bulletinPdfUrl String?
  datePaiement   DateTime @default(now())

  @@unique([contratId, periode])
}

model DeclarationCnps {
  id     String  @id @default(uuid())

  contratId String  @unique
  contrat   Contrat @relation(fields: [contratId], references: [id], onDelete: Cascade)

  numeroCnps      String   @unique
  numeroCmu       String   @unique
  dateDeclaration DateTime @default(now())
}

model OffreEmploi {
  id String @id @default(uuid())

  agenceId String
  agence   Agence @relation(fields: [agenceId], references: [id], onDelete: Cascade)

  titre       String
  typeContrat String // BTP, GARDIENNAGE, DOMESTIQUE, RESTAURATION, AGRICULTURE, MANUTENTION, AUTRE
  description String
  lieuTravail String
  salaireBrut Float
  nombrePostes Int    @default(1)

  statut String @default("OUVERTE")

  candidatures Candidature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Candidature {
  id String @id @default(uuid())

  offreId       String
  offre         OffreEmploi @relation(fields: [offreId], references: [id], onDelete: Cascade)
  travailleurId String
  travailleur   Travailleur @relation(fields: [travailleurId], references: [id], onDelete: Cascade)

  statut  String  @default("EN_ATTENTE")
  message String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offreId, travailleurId])
}

// Journal d'audit : volontairement sans relations (pas de onDelete: Cascade)
// pour que la tracabilite survive independamment du cycle de vie des autres
// entites. userId/role sont denormalises (copie de la valeur au moment de
// l'action) plutot que lies par cle etrangere.
model JournalAudit {
  id String @id @default(uuid())

  userId String? // null pour les actions non authentifiees (ex: tentative de connexion echouee)
  role   String?
  action String // ex: CONNEXION, CONNEXION_ECHOUEE, CONTRAT_CREE, CONTRAT_SIGNE, PAIEMENT_EFFECTUE...

  entite   String? // ex: Contrat, Paiement, DemandeAgrement, Candidature
  entiteId String?

  details String? // JSON libre (contexte additionnel, non sensible)
  adresseIp String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
